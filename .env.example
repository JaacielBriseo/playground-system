APP_NAME="SaaS Template"
APP_ENV=local                    # production: set to "production"
APP_KEY=
APP_DEBUG=true                   # production: MUST be false
# Include the port when using `php artisan serve` (e.g. http://localhost:8000).
# Production: the full domain.
APP_URL=http://localhost:8000

# Shows a dismissible "beta" banner across the app.
BETA_MODE=false

# UI language. Ships with "es" and "en" — see lang/{locale}.json.
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Timezone used to render dates to users. Storage is always UTC.
APP_DISPLAY_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                  # production: set to "warning"

# Matches the `db` service in docker-compose.dev.yml (mysql:8.4).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false            # production: MUST be true
SESSION_PATH=/
SESSION_DOMAIN=null              # production: your domain, e.g. yourdomain.com
SESSION_SECURE_COOKIE=false      # production: MUST be true (requires HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev: the mailpit service catches everything at http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if you set FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SANCTUM_STATEFUL_DOMAINS=
FRONTEND_URL=                    # production: same as APP_URL (CORS allowed_origins)

# ---------------------------------------------------------------------------
# Stripe — the app boots without these, but every tenant stays locked until a
# subscription exists. Create one recurring price in the Stripe dashboard and
# put its id in STRIPE_PRICE_ID.
#
# Local webhooks:
#   stripe listen --forward-to http://localhost:8000/stripe/webhook
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Free trial length, in days, applied at checkout.
SUBSCRIPTION_TRIAL_DAYS=14

CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
